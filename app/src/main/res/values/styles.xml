<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Home.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:colorPrimaryDark"  tools:targetApi="21">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>

        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorAccent">@color/md_theme_light_primary</item>

        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="NormalActivity.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="preferenceTheme">@style/PreferenceTheme</item>
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorAccent">@color/md_theme_light_primary</item>
        <item name="android:windowBackground">@color/Light.Background</item>
    </style>

    <style name="NormalActivity.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="preferenceTheme">@style/PreferenceTheme</item>
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorAccent">@color/md_theme_dark_primary</item>
        <item name="android:windowBackground">@color/Dark.Background</item>
    </style>

    <style name="NormalActivity.Black" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="preferenceTheme">@style/PreferenceTheme</item>
        <item name="colorPrimary">#000000</item>
        <item name="colorAccent">@color/md_theme_dark_primary</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="PreferenceTheme" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/PreferenceCategoryStyle</item>
        <item name="preferenceStyle">@style/PreferenceItemStyle</item>
        <item name="checkBoxPreferenceStyle">@style/CheckBoxPreferenceStyle</item>
        <item name="switchPreferenceStyle">@style/SwitchPreferenceStyle</item>
        <item name="switchPreferenceCompatStyle">@style/SwitchPreferenceStyle</item>
        <item name="editTextPreferenceStyle">@style/PreferenceItemStyle</item>
        <item name="dialogPreferenceStyle">@style/PreferenceItemStyle</item>
        <item name="seekBarPreferenceStyle">@style/SeekBarPreferenceStyle</item>
    </style>

    <style name="SeekBarPreferenceStyle" parent="Preference.SeekBarPreference.Material">
        <item name="android:layout">@layout/preference_seekbar_material</item>
    </style>

    <style name="PreferenceCategoryStyle" parent="Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_material</item>
    </style>

    <style name="PreferenceItemStyle" parent="Preference.Material">
        <item name="android:layout">@layout/preference_material</item>
    </style>

    <style name="SwitchPreferenceStyle" parent="@style/Preference.SwitchPreference">
    </style>

    <style name="CheckBoxPreferenceStyle" parent="@style/Preference.CheckBoxPreference">
    </style>

    <style name="Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <style name="IntroTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowTranslucentStatus" tools:ignore="NewApi">true</item>
        <item name="android:windowBackground">@null</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="FilePickerTheme" parent="NNF_BaseTheme">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="Theme.CrashReport" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

</resources>